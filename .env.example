# Todas opcionales. Sin configurar, la app funciona igual con valores por defecto.

# Carpeta donde se guardan los backups de la base (default: ./backups)
CALFI_BACKUP_DIR=

# Rutas a los Excel de migración histórica de datos (solo necesarias para
# correr esos endpoints de administración una vez; no hacen falta para el uso normal)
CALFI_MIGRATE_HISTORICAL_XLSX=
CALFI_SYNC_HISTORICAL_XLSX=
